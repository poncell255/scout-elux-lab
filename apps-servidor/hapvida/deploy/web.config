<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite><rules><rule name="hapvida-wsl" stopProcessing="true">
      <match url="(.*)" />
      <action type="Rewrite" url="http://localhost:3101/hapvida/{R:1}" />
    </rule></rules></rewrite>
    <security><requestFiltering><requestLimits maxAllowedContentLength="6291456" /></requestFiltering></security>
  </system.webServer>
</configuration>
