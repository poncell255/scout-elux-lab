<?xml version="1.0" encoding="UTF-8"?>
<!-- TV Projetos: proxy reverso do PopulosHub para os eLux da OU "TV Projetos".
     Injeta /tv/tv.js nas páginas (login automático, aba do portfólio, tela cheia) e
     tira o atributo Secure do cookie de sessão, porque o proxy é HTTP na rede interna. -->
<configuration>
  <system.webServer>
    <rewrite>
      <rules>
        <rule name="TV - arquivos locais" stopProcessing="true">
          <match url="^tv/" />
          <action type="None" />
        </rule>
        <rule name="TV - proxy PopulosHub" stopProcessing="true">
          <match url="(.*)" />
          <serverVariables>
            <set name="HTTP_X_ORIGINAL_ACCEPT_ENCODING" value="{HTTP_ACCEPT_ENCODING}" />
            <set name="HTTP_ACCEPT_ENCODING" value="" />
          </serverVariables>
          <action type="Rewrite" url="https://populoshub.populos.com.br/{R:1}" />
        </rule>
      </rules>
      <outboundRules>
        <rule name="TV - injeta tv.js" preCondition="html">
          <match filterByTags="None" pattern="&lt;head&gt;" />
          <action type="Rewrite" value="&lt;head&gt;&lt;script src=&quot;/tv/tv.js?v=5&quot;&gt;&lt;/script&gt;" />
        </rule>
        <rule name="TV - cookie sem Secure">
          <match serverVariable="RESPONSE_Set_Cookie" pattern="^(.*?);\s*Secure(.*)$" />
          <action type="Rewrite" value="{R:1}{R:2}" />
        </rule>
        <preConditions>
          <preCondition name="html">
            <add input="{RESPONSE_CONTENT_TYPE}" pattern="^text/html" />
          </preCondition>
        </preConditions>
      </outboundRules>
    </rewrite>
    <staticContent>
      <clientCache cacheControlMode="DisableCache" />
    </staticContent>
  </system.webServer>
</configuration>
